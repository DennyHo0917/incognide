  - {{ Jinx('shell', repo='NPC-Worldwide/npcsh') }}
  - {{ Jinx('read', repo='NPC-Worldwide/npcsh') }}
  - {{ Jinx('write', repo='NPC-Worldwide/npcsh') }}
  - {{ Jinx('load_file', repo='NPC-Worldwide/npcsh') }}
  - {{ Jinx('edit_file', repo='NPC-Worldwide/npcsh') }}
