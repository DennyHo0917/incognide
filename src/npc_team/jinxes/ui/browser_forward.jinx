jinx_name: browser_forward
description: Navigate forward in a browser pane history
permissions:
  default: allow
inputs:
- paneId:
    type: string
    description: The ID of the browser pane (omit for active)
    required: false
- window_id:
    type: string
    description: The Incognide window ID to target (omit to use current window)
    required: false
steps:
- name: browser_forward
  engine: incognide
  action: browser_forward
  args:
    paneId: '{{ paneId | default(''active'') }}'
  window_id: '{{ window_id }}'
