jinx_name: get_browser_content
description: Return the cleaned full HTML and interactive element summary for a browser
  pane. Use this to understand the current page before typing/clicking.
permissions:
  default: allow
inputs:
- paneId
- maxChars
- includeInteractive
- window_id
steps:
- name: get_browser_content
  engine: incognide
  action: get_browser_content
  args:
    paneId: '{{ paneId | default(''active'') }}'
    maxChars: '{{ maxChars | default(100000) }}'
    includeInteractive: '{{ includeInteractive | default(true) }}'
  window_id: '{{ window_id }}'