jinx_name: browser_find_elements
description: Find interactive elements in a browser pane and return selector/text
  summaries. Prefer this over browser_screenshot when inspecting a page.
permissions:
  default: allow
inputs:
- paneId
- selector
- maxResults
- window_id
steps:
- name: browser_find_elements
  engine: incognide
  action: browser_find_elements
  args:
    paneId: '{{ paneId | default(''active'') }}'
    selector: '{{ selector | default('''') }}'
    maxResults: '{{ maxResults | default(50) }}'
  window_id: '{{ window_id }}'