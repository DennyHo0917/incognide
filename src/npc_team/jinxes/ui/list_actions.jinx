jinx_name: list_actions
description: List all available studio actions
permissions:
  default: allow
steps:
- name: list_actions
  engine: incognide
  action: list_actions
  args: {}
  window_id: '{{ window_id }}'
inputs:
- window_id:
    type: string
    description: The Incognide window ID to target (omit to use current window)
    required: false
