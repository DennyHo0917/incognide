jinx_name: browser_eval
description: Execute arbitrary JavaScript in a browser pane
permissions:
  default: allow
inputs:
- paneId
- code
- window_id
steps:
- name: browser_eval
  engine: incognide
  action: browser_eval
  args:
    paneId: '{{ paneId | default(''active'') }}'
    code: '{{ code }}'
  window_id: '{{ window_id }}'