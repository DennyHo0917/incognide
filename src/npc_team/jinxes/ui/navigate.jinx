jinx_name: navigate
description: 'Navigate within a pane. Browser: go to URL. Presentation: go to slide
  (pass index as target). Spreadsheet: switch sheet (pass sheet name as target).

  '
permissions:
  default: allow
inputs:
- target
- pane_id: active
- window_id:
    type: string
    description: The Incognide window ID to target (omit to use current window)
    required: false
steps:
- name: navigate
  engine: incognide
  action: navigate_pane
  args:
    target: '{{ target }}'
    paneId: '{{ pane_id }}'
  window_id: '{{ window_id }}'
