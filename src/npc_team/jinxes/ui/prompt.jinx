jinx_name: prompt
description: 'Ask the user for input. Types: choices (pick from options), confirm
  (yes/no), text (free text input), form (multiple fields). Returns the user''s response.

  '
permissions:
  default: allow
inputs:
- message
- prompt_type: choices
- options: '[]'
- window_id:
    type: string
    description: The Incognide window ID to target (omit to use current window)
    required: false
steps:
- name: prompt
  engine: incognide
  action: prompt_user
  args:
    message: '{{ message }}'
    prompt_type: '{{ prompt_type }}'
    options: '{{ options }}'
  window_id: '{{ window_id }}'
