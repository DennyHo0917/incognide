jinx_name: notify
description: Show a notification toast to the user. Type can be info, success, warning,
  or error.
permissions:
  default: allow
inputs:
- message
- type: info
- duration: 3000
- window_id
steps:
- name: notify
  engine: incognide
  action: notify
  args:
    message: '{{ message }}'
    type: '{{ type }}'
    duration: '{{ duration }}'
  window_id: '{{ window_id }}'