jinx_name: browser_screenshot
description: Take a screenshot of a browser pane and return it as a data URL. Use
  only as a last resort when get_browser_content and browser_find_elements are not
  enough.
permissions:
  default: allow
inputs:
- paneId
- window_id
steps:
- name: browser_screenshot
  engine: incognide
  action: browser_screenshot
  args:
    paneId: '{{ paneId | default(''active'') }}'
  window_id: '{{ window_id }}'