jinx_name: close_pane
description: Close a pane in Incognide. Use pane_id to specify which pane, or leave
  empty to close the active pane.
permissions:
  default: allow
inputs:
- pane_id: active
- window_id:
    type: string
    description: The Incognide window ID to target (omit to use current window)
    required: false
steps:
- name: close_pane
  engine: incognide
  action: close_pane
  args:
    paneId: '{{ pane_id }}'
  window_id: '{{ window_id }}'
