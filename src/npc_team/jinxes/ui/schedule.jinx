jinx_name: schedule
description: 'Manage cron jobs. Actions: list (no args), add (needs schedule + command
  + job_name), remove (needs job_name), status (needs job_name). Schedule uses cron
  syntax, e.g. ''*/5 * * * *'' for every 5 minutes.

  '
permissions:
  default: allow
inputs:
- action
- schedule: ''
- command: ''
- job_name: ''
- window_id:
    type: string
    description: The Incognide window ID to target (omit to use current window)
    required: false
steps:
- name: schedule
  engine: python
  code: "import requests, json as _json\n_port = 5437\ntry:\n    import socket as\
    \ _sock\n    for _p in [5437, 5337]:\n        try:\n            _s = _sock.socket(_sock.AF_INET,\
    \ _sock.SOCK_STREAM)\n            _s.settimeout(0.3)\n            _s.connect(('127.0.0.1',\
    \ _p))\n            _s.close()\n            _port = _p\n            break\n  \
    \      except Exception:\n            pass\nexcept Exception:\n    pass\n_base\
    \ = f'http://127.0.0.1:{_port}/api/cron'\n_act = context.get('action', 'list')\n\
    if _act == 'list':\n    _r = requests.get(f'{_base}/jobs', timeout=10)\nelif _act\
    \ == 'add':\n    _r = requests.post(f'{_base}/schedule', json={\n        'schedule':\
    \ context.get('schedule', ''),\n        'command': context.get('command', ''),\n\
    \        'jobName': context.get('job_name', '')\n    }, timeout=10)\nelif _act\
    \ == 'remove':\n    _r = requests.post(f'{_base}/unschedule', json={\n       \
    \ 'jobName': context.get('job_name', '')\n    }, timeout=10)\nelif _act == 'status':\n\
    \    _jn = context.get('job_name', '')\n    _r = requests.get(f'{_base}/status/{_jn}',\
    \ timeout=10)\nelse:\n    output = f'Unknown action: {_act}. Use: list, add, remove,\
    \ status'\n    _r = None\nif _r is not None:\n    output = _json.dumps(_r.json(),\
    \ indent=2)\n"
