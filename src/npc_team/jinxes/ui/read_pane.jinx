jinx_name: read_pane
description: 'Read content from any pane. Works on all types: editor (file text),
  browser (url + title), terminal (output), csv (data + stats), docx (text), pptx
  (slides), chat (recent messages).

  '
permissions:
  default: allow
inputs:
- pane_id: active
- window_id:
    type: string
    description: The Incognide window ID to target (omit to use current window)
    required: false
steps:
- name: read_pane
  engine: incognide
  action: read_pane
  args:
    paneId: '{{ pane_id }}'
  window_id: '{{ window_id }}'
