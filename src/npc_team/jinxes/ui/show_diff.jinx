jinx_name: show_diff
description: Show a diff comparison between two text contents
permissions:
  default: allow
inputs:
- original
- modified
- window_id
steps:
- name: show_diff
  engine: incognide
  action: show_diff
  args:
    original: '{{ original }}'
    modified: '{{ modified }}'
  window_id: '{{ window_id }}'