jinx_name: browser_type
description: Type text into an input element in a browser pane
permissions:
  default: allow
inputs:
- paneId
- selector
- text
- clear
- submit
- window_id
steps:
- name: browser_type
  engine: incognide
  action: browser_type
  args:
    paneId: '{{ paneId | default(''active'') }}'
    selector: '{{ selector }}'
    text: '{{ text }}'
    clear: '{{ clear | default(true) }}'
    submit: '{{ submit | default(false) }}'
  window_id: '{{ window_id }}'